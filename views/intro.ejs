<!DOCTYPE html>
<html lang="<%= language %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <p><%= introduction %></p>

    <form action="/intro" method="post">
        <label for="language">Nyelv:</label>
        <select id="language" name="language">
            <option value="hu" <%= language === 'hu' ? 'selected' : '' %>>Magyar</option>
            <option value="en" <%= language === 'en' ? 'selected' : '' %>>English</option>
        </select>
        <button type="submit">Valtas</button>
    </form>

    <p><a href="/quadratic">Masodfoku egyenlet</a></p>
    <p><a href="/color-picker">Szinkivalaszto</a></p>
    <p><a href="/afa">AFA szamitas</a></p>
</body>
</html>