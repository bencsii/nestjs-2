<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1><%= title %></h1>
    <p>ax^2 + bx + c = 0</p>
    <form action="/quadratic" method="post">
        <label for="a">a:</label>
        <input type="number" id="a" name="a" step="any" value="<%= a %>" required>

        <label for="b">b:</label>
        <input type="number" id="b" name="b" step="any" value="<%= b %>" required>

        <label for="c">c:</label>
        <input type="number" id="c" name="c" step="any" value="<%= c %>" required>

        <button type="submit">Szamolas</button>
    </form>
    <% if (result) { %>
        <p><strong><%= result %></strong></p>
    <% } %>
    <p><a href="/color-picker">Szinkivalaszto</a></p>
</body>
</html>